# DNS A/AAAA records for these hosts must point to this server.
# Caddy obtains and renews trusted TLS certificates automatically.
adctrl.koreokorp.com {
  encode zstd gzip
  reverse_proxy 127.0.0.1:4173 {
    header_up X-Forwarded-For {remote_host}
  }
}

koreokorp.com, www.koreokorp.com {
  encode zstd gzip
  @admin path /admin* /api/admin/* /mockups/koreokorp-v2/admin*
  respond @admin 404
  reverse_proxy 127.0.0.1:4173 {
    header_up X-Forwarded-For {remote_host}
  }
}
