{
  "name": "koreokorp-v2-mockup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "dev:app": "next dev --port 4180",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start:app": "next start --port 4180",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "backlog": "backlog",
    "backlog:board": "backlog board",
    "backlog:browser": "backlog browser --no-open",
    "backlog:check": "backlog doctor",
    "check": "node scripts/check.mjs",
    "test": "npm run check && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:app": "playwright test tests/app",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "backlog.md": "1.53.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.8",
    "typescript": "5.9.3"
  }
}
